# ============================================================================
# Dockerfile.agent for rounds
# ============================================================================
# An autonomous diagnostic agent for OpenTelemetry data analysis
# Python 3.11+ daemon using Claude Code CLI for LLM-powered diagnosis
# ============================================================================

# ============================================================================
# Stage 1: Base Environment Setup
# ============================================================================
FROM switchyard-orchestrator:latest

# The base image already includes:
# - Claude CLI (REQUIRED - must be present)
# - Git CLI (REQUIRED - must be present)
# - GitHub CLI (REQUIRED - must be present)
# - Python 3.11
# - Essential build tools
# - procps package (provides 'ps' command needed by Claude CLI)

USER root

# ============================================================================
# Stage 2: Install Project-Specific Dependencies
# ============================================================================
# Install additional system dependencies for the rounds project
# - sqlite3: For the signature database operations
# - curl: For health checks and API testing
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        sqlite3 \
        curl \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# ============================================================================
# Stage 3: Pre-install Python Dependencies (when requirements.txt exists)
# ============================================================================
# The rounds project will need these core Python packages:
# - httpx or requests: For SigNoz API polling
# - pydantic: For configuration validation
# - python-dotenv: For .env file support

WORKDIR /workspace/rounds

# Install all project dependencies from pyproject.toml
# Core dependencies:
#   pydantic, pydantic-settings: Configuration validation
#   aiosqlite: Async SQLite for signature store
#   httpx: HTTP client for telemetry API polling
#   python-dotenv: .env file support
#   opentelemetry-*: Tracing and telemetry export
# Optional adapters:
#   asyncpg: PostgreSQL signature store adapter
#   openai: OpenAI diagnosis adapter
# Dev/test tooling:
#   pytest, pytest-asyncio, pytest-cov: Test execution
#   mypy: Type checking
#   ruff: Linting
RUN pip install --no-cache-dir \
    pydantic \
    pydantic-settings \
    aiosqlite \
    httpx \
    python-dotenv \
    opentelemetry-api \
    opentelemetry-sdk \
    opentelemetry-exporter-otlp-proto-http \
    asyncpg \
    openai \
    pytest \
    pytest-asyncio \
    pytest-cov \
    mypy \
    ruff

# Create application data directories with orchestrator ownership so that
# Docker named volumes mounted at these paths inherit the correct permissions
# on first use (Docker copies image content into a new empty volume).
RUN mkdir -p /app/data /app/reports && \
    chown -R orchestrator:orchestrator /app/data /app/reports

# ============================================================================
# Stage 4: Set PYTHONPATH for Runtime
# ============================================================================
# Source code is mounted at /workspace/rounds at runtime by the orchestrator.
# The 'rounds' package lives at /workspace/rounds/rounds/, so the parent
# directory must be on PYTHONPATH for imports to resolve.
ENV PYTHONPATH="/workspace/rounds"

# ============================================================================
# Stage 5: Switch to Runtime User
# ============================================================================
USER orchestrator

# ============================================================================
# Stage 6: Verification (MANDATORY)
# ============================================================================
# Verify all critical CLIs are present (from base image)
RUN claude --version && \
    git --version && \
    gh --version

# Verify Python and installed packages
RUN python3 --version && \
    pip --version && \
    python3 -c "import httpx; import pydantic; import dotenv; import pydantic_settings; import aiosqlite; import opentelemetry; import asyncpg; import openai" && \
    python3 -c "from opentelemetry.sdk.resources import Resource; from opentelemetry.sdk.trace import TracerProvider; from opentelemetry.exporter.otlp.proto.http.trace_exporter import OTLPSpanExporter" && \
    pytest --version && \
    mypy --version && \
    ruff --version

# ============================================================================
# Default command
# ============================================================================
CMD ["/bin/bash"]
