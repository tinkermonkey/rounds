{
  "title": "Rounds Self-Observability",
  "description": "Health of the Rounds diagnostic daemon itself: poll/investigation/resolution cycle latency, signature volume by status, and diagnosis spend. Populated from the rounds-cli self-telemetry OTLP export (ENABLE_SELF_TELEMETRY=true), independent of any target-application telemetry.",
  "tags": ["rounds", "self-observability"],
  "layout": [
    { "i": "poll-cycle-latency", "x": 0, "y": 0, "w": 6, "h": 3 },
    { "i": "investigation-cycle-latency", "x": 6, "y": 0, "w": 6, "h": 3 },
    { "i": "resolution-cycle-latency", "x": 0, "y": 3, "w": 6, "h": 3 },
    { "i": "poll-cycle-error-rate", "x": 6, "y": 3, "w": 6, "h": 3 },
    { "i": "signature-counts-by-status", "x": 0, "y": 6, "w": 6, "h": 3 },
    { "i": "daily-diagnosis-cost-total", "x": 6, "y": 6, "w": 3, "h": 3 },
    { "i": "daily-diagnosis-cost-by-step", "x": 9, "y": 6, "w": 3, "h": 3 }
  ],
  "variables": {},
  "widgets": [
    {
      "id": "poll-cycle-latency",
      "title": "Poll Cycle Latency (p50 / p95)",
      "description": "Duration of each executed poll cycle, from rounds.daemon.poll_cycle.duration.",
      "panelTypes": "graph",
      "isStacked": false,
      "nullZeroValues": "zero",
      "opacity": "1",
      "yAxisUnit": "s",
      "query": {
        "queryType": "builder",
        "promql": [],
        "clickhouse_sql": [],
        "builder": {
          "queryData": [
            {
              "queryName": "A",
              "dataSource": "metrics",
              "aggregateOperator": "p50",
              "aggregateAttribute": {
                "key": "rounds.daemon.poll_cycle.duration",
                "dataType": "float64",
                "type": "Histogram"
              },
              "filters": {
                "items": [
                  { "key": { "key": "service.name" }, "op": "=", "value": "rounds-cli" }
                ],
                "op": "AND"
              },
              "groupBy": [],
              "expression": "A",
              "disabled": false,
              "legend": "p50"
            },
            {
              "queryName": "B",
              "dataSource": "metrics",
              "aggregateOperator": "p95",
              "aggregateAttribute": {
                "key": "rounds.daemon.poll_cycle.duration",
                "dataType": "float64",
                "type": "Histogram"
              },
              "filters": {
                "items": [
                  { "key": { "key": "service.name" }, "op": "=", "value": "rounds-cli" }
                ],
                "op": "AND"
              },
              "groupBy": [],
              "expression": "B",
              "disabled": false,
              "legend": "p95"
            }
          ],
          "queryFormulas": []
        }
      }
    },
