      "id": "poll-cycle-error-rate",
      "title": "Poll / Investigation / Resolution Cycle Outcomes",
      "description": "Count of executed cycles by outcome (success/error), grouped by cycle type via the rounds.daemon.*.duration histograms' sample count.",
      "panelTypes": "graph",
      "isStacked": true,
      "nullZeroValues": "zero",
