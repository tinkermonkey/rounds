# ============================================================================
# Rounds Configuration Template
# ============================================================================
# DEPLOYMENT:
#   1. Copy this file to .env.rounds in your target project root
#   2. Configure the settings below for your environment
#   3. Ensure docker-compose.rounds.yml is also in your target project root
#   4. Run: docker-compose -f docker-compose.rounds.yml up -d
#
# See docs/QUICK_START_TARGET_PROJECT.md for detailed configuration guide.
#
# Required fields:
#   - TELEMETRY_BACKEND: The observability platform to query for errors
#   - SIGNOZ_API_URL, SIGNOZ_API_KEY: If using SigNoz backend
#   - RUN_MODE: "daemon" for continuous polling
#
# Optional fields have sensible defaults suitable for most deployments.
# ============================================================================

# ============================================================================
# Run Mode
# ============================================================================
# Options: "daemon" (production), "cli" (interactive), "webhook" (HTTP server)
RUN_MODE=daemon

# ============================================================================
# Telemetry Backend Configuration
# ============================================================================
# Supported backends: "signoz", "jaeger", "grafana_stack"
TELEMETRY_BACKEND=signoz

# SigNoz Configuration (if TELEMETRY_BACKEND=signoz)
# URL to the SigNoz API endpoint - choose based on deployment scenario:
#   Host machine: http://host.docker.internal:4418
#   Docker network: http://signoz:4418 (requires shared network)
#   Remote server: https://signoz.example.com
SIGNOZ_API_URL=http://host.docker.internal:3301
# Optional: API key for SigNoz authentication
SIGNOZ_API_KEY=

# Jaeger Configuration (if TELEMETRY_BACKEND=jaeger)
# JAEGER_API_URL=http://localhost:16686

# Grafana Stack Configuration (if TELEMETRY_BACKEND=grafana_stack)
# GRAFANA_LOKI_URL=http://localhost:3100
# GRAFANA_TEMPO_URL=http://localhost:3200
# GRAFANA_PROMETHEUS_URL=http://localhost:9090
# GRAFANA_API_KEY=

# ============================================================================
# Signature Store Configuration
# ============================================================================
# Supported backends: "sqlite" (default), "postgresql"
STORE_BACKEND=sqlite

# SQLite Configuration (if STORE_BACKEND=sqlite)
# Path to the SQLite database file (must be writable)
STORE_SQLITE_PATH=/app/data/signatures.db

# PostgreSQL Configuration (if STORE_BACKEND=postgresql)
# STORE_POSTGRESQL_URL=postgresql://user:password@localhost/rounds

# ============================================================================
# Diagnosis Engine Configuration
# ============================================================================
# Supported backends: "claude_code" (default), "openai", "agent_node"
DIAGNOSIS_BACKEND=claude_code

# Claude Code Configuration (if DIAGNOSIS_BACKEND=claude_code)
#
# Authentication — set exactly ONE of the following two options:
#
# Option A: Anthropic API key (direct API access, pay-per-token)
#   Format: sk-ant-...
ANTHROPIC_API_KEY=
#
# Option B: Claude Code OAuth token (Claude.ai subscription — Pro/Teams/Enterprise)
#   Obtain by running 'claude login' in the Claude Code CLI, then copy the token
#   from ~/.claude/.credentials.json, or via your organization's OAuth provisioning.
#   When set, takes precedence over ANTHROPIC_API_KEY.
# CLAUDE_CODE_OAUTH_TOKEN=
#
# Budget per diagnosis in USD (default: 5.0)
CLAUDE_CODE_BUDGET_USD=5.0
# Claude model to use (default: claude-sonnet-4-6)
CLAUDE_MODEL=claude-sonnet-4-6

# OpenAI Configuration (if DIAGNOSIS_BACKEND=openai)
# OPENAI_API_KEY=sk-...
# Model to use (default: gpt-4)
# OPENAI_MODEL=gpt-4
# Budget per diagnosis in USD (default: 2.0)
# OPENAI_BUDGET_USD=2.0

# Agent Node Configuration (required if DIAGNOSIS_BACKEND=agent_node)
# Comma-separated signoz_service_name:mcp_key:workspace_name triples mapping
# each monitored service to the agent node that should diagnose it. Only
# services listed here will be diagnosed by the agent_node backend.
# Example: AGENT_NODE_SERVICE_MAP=my-api:node1:workspace-a,worker:node2:workspace-b
# NOTE (Ansible deployments): this field is not yet templated by
# templates/env.rounds.j2 / vault/secrets.yml. Add a rounds_agent_node_service_map
# vault variable and wire it into the template before relying on Ansible to
# generate AGENT_NODE_SERVICE_MAP for a deployment.
# AGENT_NODE_SERVICE_MAP=
#
# JSON map from agent-node mcp_key to SSH-reachable hostname. Used to resolve
# the SSH target for a given mcp_key. Required if DIAGNOSIS_BACKEND=agent_node.
# Example: AGENT_NODE_HOST_MAP={"node1":"host-a","node2":"host-b"}
# AGENT_NODE_HOST_MAP=
#
# Budget per diagnosis for the agent_node backend in USD (default: 2.0)
AGENT_NODE_BUDGET_USD=2.0

# Daily budget limit across all diagnoses (USD)
DAILY_BUDGET_LIMIT=50.0

# ============================================================================
# Notification Configuration
# ============================================================================
# Supported backends: "stdout", "markdown", "github_issue"
NOTIFICATION_BACKEND=markdown

# Output directory for markdown reports
NOTIFICATION_OUTPUT_DIR=/app/reports

# GitHub Issue Configuration (if NOTIFICATION_BACKEND=github_issue)
# GitHub personal access token
# GITHUB_TOKEN=ghp_...
# Repository for issue creation (owner/repo format)
# GITHUB_REPO=myorg/myrepo

# ============================================================================
# Polling Configuration
# ============================================================================
# Interval between polling cycles (seconds)
POLL_INTERVAL_SECONDS=60

# Number of events to retrieve per poll cycle
POLL_BATCH_SIZE=100

# Lookback window for error queries (minutes)
ERROR_LOOKBACK_MINUTES=15

# ============================================================================
# Service Filter Configuration
# ============================================================================
# Comma-separated list of service names to monitor (empty = all services).
# Names must match exactly what the telemetry backend reports (case-sensitive).
# Run: python -m rounds.main cli-run list-services    to enumerate available names.
SERVICE_FILTER=

# JSON map from telemetry service name to host machine.
# Used to route diagnosis context to the correct codebase host.
# Example: SERVICE_HOST_MAP={"my-api":"t5610","worker-service":"petit-cochon"}
SERVICE_HOST_MAP={}

# ============================================================================
# Codebase Configuration
# ============================================================================
# Path to the target codebase for diagnosis context
CODEBASE_PATH=/workspace/target

# ============================================================================
# Logging Configuration
# ============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# Log format: json or text
LOG_FORMAT=text

# ============================================================================
# Webhook Configuration (if RUN_MODE=webhook)
# ============================================================================
# Host to listen on
# WEBHOOK_HOST=0.0.0.0
# Port to listen on
# WEBHOOK_PORT=8080
# API key for webhook authentication (recommended for production)
# WEBHOOK_API_KEY=
# Require API key authentication
# WEBHOOK_REQUIRE_AUTH=false

# ============================================================================
# Development Configuration
# ============================================================================
# Enable debug mode with verbose logging (default: false)
# DEBUG=false

# ============================================================================
# Claude Code CLI Version (optional)
# ============================================================================
# Specific Claude Code CLI version to install
# Leave empty for latest version (recommended)
# CLAUDE_CODE_VERSION=
