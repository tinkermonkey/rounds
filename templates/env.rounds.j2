# .env.rounds — generated by Ansible from vault/secrets.yml
# Do not edit manually; changes will be overwritten on next deployment.

# ============================================================================
# Run Mode
# ============================================================================
RUN_MODE={{ rounds_run_mode | default('daemon') }}

# ============================================================================
# Telemetry Backend
# ============================================================================
TELEMETRY_BACKEND={{ rounds_telemetry_backend | default('signoz') }}

SIGNOZ_API_URL={{ rounds_signoz_api_url | default('http://localhost:3301') }}
SIGNOZ_API_KEY={{ rounds_signoz_api_key | default('') }}

JAEGER_API_URL={{ rounds_jaeger_api_url | default('http://localhost:16686') }}

GRAFANA_LOKI_URL={{ rounds_grafana_loki_url | default('http://localhost:3100') }}
GRAFANA_TEMPO_URL={{ rounds_grafana_tempo_url | default('http://localhost:3200') }}
GRAFANA_PROMETHEUS_URL={{ rounds_grafana_prometheus_url | default('http://localhost:9090') }}
GRAFANA_API_KEY={{ rounds_grafana_api_key | default('') }}

# ============================================================================
# Signature Store
# ============================================================================
STORE_BACKEND={{ rounds_store_backend | default('sqlite') }}
STORE_SQLITE_PATH=/app/data/signatures.db
{% if rounds_store_postgresql_url | default('') %}
STORE_POSTGRESQL_URL={{ rounds_store_postgresql_url }}
{% endif %}

# ============================================================================
# Diagnosis Engine
# ============================================================================
DIAGNOSIS_BACKEND={{ rounds_diagnosis_backend | default('claude_code') }}
{% if rounds_anthropic_api_key | default('') %}
ANTHROPIC_API_KEY={{ rounds_anthropic_api_key }}
{% endif %}
{% if rounds_claude_code_oauth_token | default('') %}
CLAUDE_CODE_OAUTH_TOKEN={{ rounds_claude_code_oauth_token }}
{% endif %}
CLAUDE_CODE_BUDGET_USD={{ rounds_claude_code_budget_usd | default('5.0') }}
CLAUDE_MODEL={{ rounds_claude_model | default('claude-sonnet-4-6') }}
{% if rounds_openai_api_key | default('') %}
OPENAI_API_KEY={{ rounds_openai_api_key }}
{% endif %}
DAILY_BUDGET_LIMIT={{ rounds_daily_budget_limit | default('50.0') }}

# ============================================================================
# Notifications
# ============================================================================
NOTIFICATION_BACKEND={{ rounds_notification_backend | default('markdown') }}
NOTIFICATION_OUTPUT_DIR=/app/reports
{% if rounds_github_token | default('') %}
GITHUB_TOKEN={{ rounds_github_token }}
GITHUB_REPO={{ rounds_github_repo | default('') }}
{% endif %}

# ============================================================================
# Polling
# ============================================================================
POLL_INTERVAL_SECONDS={{ rounds_poll_interval_seconds | default('60') }}
POLL_BATCH_SIZE={{ rounds_poll_batch_size | default('100') }}
ERROR_LOOKBACK_MINUTES={{ rounds_error_lookback_minutes | default('15') }}

# ============================================================================
# Service Filtering
# ============================================================================
SERVICE_FILTER={{ rounds_service_filter | default('') }}
SERVICE_HOST_MAP={{ rounds_service_host_map | default('{}') }}

# ============================================================================
# Codebase
# ============================================================================
CODEBASE_PATH=/workspace/target

# ============================================================================
# Logging
# ============================================================================
LOG_LEVEL={{ rounds_log_level | default('INFO') }}
LOG_FORMAT={{ rounds_log_format | default('text') }}

# ============================================================================
# Webhook (only used when RUN_MODE=webhook)
# ============================================================================
{% if rounds_webhook_api_key | default('') %}
WEBHOOK_API_KEY={{ rounds_webhook_api_key }}
WEBHOOK_REQUIRE_AUTH={{ rounds_webhook_require_auth | default('true') }}
{% endif %}
